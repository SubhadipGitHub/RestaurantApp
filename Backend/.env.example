# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env for local development.
# PORT is supplied by the host (Render injects it) -- do not set it here.
# ---------------------------------------------------------------------------

# MongoDB -- paste the string from Atlas's "Connect > Drivers" dialog.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=restoDB

# Alternatively, omit MONGO_URI and supply the parts instead:
# MONGO_USERNAME=restoapp
# MONGO_PASSWORD=your-db-password
# MONGO_CLUSTER_URL=cluster0.xxxxx.mongodb.net

# Google OAuth -- from Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
# Must match an Authorized redirect URI on the OAuth client exactly.
GOOGLE_CLIENT_REDIRECT=http://localhost:3000/api/backend/auth/google

# Where to send the browser after sign-in.
FRONTEND_URL=http://localhost:3000

# Session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Set false for local http development so the cookie is accepted over plain HTTP.
COOKIE_SECURE=false

# The API documents every mutation endpoint, so keep this off in production.
ENABLE_DOCS=true
